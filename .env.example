# ExamTwin AI Environment Configuration Example
# Copy this file to .env and provide your secrets and environment-specific values.

# -----------------------------------------------------------------------------
# LLM & Generative AI Configuration
# -----------------------------------------------------------------------------
# Google Gemini API key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model for explanations, hints, and retest generation
GEMINI_MODEL=gemini-3.8-flash

# Pretrained embedding model for semantic retrieval
EMBEDDING_MODEL=gemini-embedding-001

# Vector dimension matching the chosen embedding model (e.g., 768 for text-embedding-004)
VECTOR_DIMENSION=768

# -----------------------------------------------------------------------------
# Database Configuration (MySQL / SQLAlchemy)
# -----------------------------------------------------------------------------
# SECURITY BEST PRACTICE: Never run application services as MySQL 'root' in production.
# Use a dedicated unprivileged application user granted only DML (SELECT, INSERT, UPDATE, DELETE).
# Example: mysql+pymysql://<app_user>:<app_password>@localhost:3306/exam_twin
DATABASE_URL=mysql+pymysql://exam_twin_app:change_me_secure_password@localhost:3306/exam_twin

# -----------------------------------------------------------------------------
# Document Ingestion & Upload Security
# -----------------------------------------------------------------------------
# Maximum allowed PDF file size in bytes (default 25 MB = 26214400 bytes)
MAX_PDF_SIZE_BYTES=26214400
# Enforce %PDF- magic byte signature validation on uploads
VALIDATE_PDF_SIGNATURE=true

# -----------------------------------------------------------------------------
# RAG Retrieval & Context Configuration
# -----------------------------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.50
RAG_MAX_CONTEXT_CHARS=6000

# -----------------------------------------------------------------------------
# Adaptive Engine Weight Configuration
# priority = w1*frequency + w2*recency + w3*recurrence + w4*difficulty - w5*recent_success
# -----------------------------------------------------------------------------
ADAPTIVE_W1_FREQUENCY=0.25
ADAPTIVE_W2_RECENCY=0.20
ADAPTIVE_W3_RECURRENCE=0.25
ADAPTIVE_W4_DIFFICULTY=0.15
ADAPTIVE_W5_RECENT_SUCCESS=0.15

# -----------------------------------------------------------------------------
# Application Environment & Logging
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
